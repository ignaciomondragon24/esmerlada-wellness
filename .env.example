# ── Base de datos (Railway provee esto automáticamente al añadir PostgreSQL) ───
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Puerto del servidor Express (Railway lo setea automáticamente) ────────────
PORT=3001

# ── (Opcional) Gemini AI ──────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
